```gitignore
# Python virtual environments
venv/
.venv/
env/
ENV/

# Python cache files
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# Secrets and credentials
.env
.env.*
!.env.example
!.env.sample
.streamlit/secrets.toml

# Generated logs
logs/
*.log
*.tmp

# React / Node.js dependencies
node_modules/
dist/
build/

# IDE and operating system files
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
```
